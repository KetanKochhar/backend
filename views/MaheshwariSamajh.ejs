<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Maheshwari Samaj</title>
    <link rel="stylesheet" href="/css/MaheshwariSamajh.css" />
</head>

<body>

    <header>
        Maheshwari Samaj
    </header>

    <img class="temple-img" src="/images/temple.jpg"
        alt="Jain Temple" />

    <div class="search-container">
        <input type="text" id="searchInput" placeholder="Search by any field..." onkeyup="searchTable()" />
    </div>

    <div class="table-container">
        <table id="samajTable">
            <thead>
                <tr>
                    <th>First Name</th>
                    <th>Father Name</th>
                    <th>Last Name</th>
                    <th>Age</th>
                    <th>Address</th>
                    <th>City</th>
                    <th>Pincode</th>
                    <th>State</th>
                </tr>
            </thead>
            <tbody>
                <% members.forEach(member=> { %>
                    <tr>
                        <td>
                            <%= member.firstName %>
                        </td>
                        <td>
                            <%= member.fatherName %>
                        </td>
                        <td>
                            <%= member.lastName %>
                        </td>
                        <td>
                            <%= member.age %>
                        </td>
                        <td>
                            <%= member.address %>
                        </td>
                        <td>
                            <%= member.city %>
                        </td>
                        <td>
                            <%= member.pincode %>
                        </td>
                        <td>
                            <%= member.state %>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>
    </div>

    <footer>
        <p>Contact Us: maheshwarisamaj@gmail.com | Phone: +91 98707 87970</p>
        <p>© 2025 Maheshwari Samaj. All rights reserved.</p>
    </footer>

    <script>
        function searchTable() {
            const input = document.getElementById("searchInput").value.toLowerCase();
            const rows = document.querySelectorAll("#samajTable tbody tr");

            rows.forEach(row => {
                const cells = row.querySelectorAll("td");
                const match = Array.from(cells).some(cell =>
                    cell.textContent.toLowerCase().includes(input)
                );
                row.style.display = match ? "" : "none";
            });
        }
    </script>

</body>

</html>