<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CustomWear - Shop</title>
    <link rel="stylesheet" href="/css/shop.css" />
</head>

<body>
    <%- include('partials/nav', { user: user }) %>

        <div class="head">
            <h1>Get free home delivery</h1>
        </div>

        <div class="shop-container">
            <!-- Sidebar Filters -->
            <div class="filter-bar-container">
                <div class="filter-sidebar">
                    <div class="filter-title-bar">
                        <h3 class="filter-title">Filters</h3>
                        <span class="filter-toggle-arrow">&#9662;</span>
                    </div>
                    <hr class="filter-divider" />

                    <!-- Gender Filter -->
                    <div class="filter-section">
                        <div class="filter-header">
                            <span class="dot"></span>
                            <span class="filter-label">Gender</span>
                        </div>
                        <div class="filter-options">
                            <label><input type="checkbox" name="gender" value="Men" /> Men</label>
                            <label><input type="checkbox" name="gender" value="Women" /> Women</label>
                        </div>
                    </div>

                    <hr class="filter-divider" />

                    <!-- Discount Filter -->
                    <div class="filter-section">
                        <div class="filter-header">
                            <span class="dot"></span>
                            <span class="filter-label">Discounts</span>
                        </div>
                        <div class="filter-options">
                            <label><input type="checkbox" name="discount" value="10" /> 10% or more</label>
                            <label><input type="checkbox" name="discount" value="20" /> 20% or more</label>
                            <label><input type="checkbox" name="discount" value="30" /> 30% or more</label>
                        </div>
                    </div>

                    <hr class="filter-divider" />

                    <!-- Price Filter -->
                    <div class="filter-section">
                        <div class="filter-header">
                            <span class="dot"></span>
                            <span class="filter-label">Price</span>
                        </div>
                        <div class="filter-options">
                            <label><input type="checkbox" name="price" value="399" /> ₹399 or more</label>
                            <label><input type="checkbox" name="price" value="499" /> ₹499 or more</label>
                        </div>
                    </div>

                    <hr class="filter-divider" />
                </div>
            </div>

            <!-- Product List -->
            <div class="products-container">

                <% if (products && products.length> 0) { %>
                    <% products.forEach(product=> { %>
                        <div class="product-card" data-gender="<%= product.gender %>" data-price="<%= product.price %>"
                            data-discount="<%= product.discount %>">
                            <img loading="lazy" src="<%= product.front_image %>" alt="<%= product.name %>" />
                            
                            <div class="promo-badge"><%= product.material %></div>
                            <h3><b>CustomWear X <%= product.name %></b></h3>
                            <p>
                                <b>Price: ₹<%= product.price %></b>
                                <s>₹<%= product.actual_price %></s>
                                <b style="color: green;">
                                    <%= product.discount %>% off
                                </b>
                            </p>
                            <button onclick="location.href='/porder-now/<%= product.id %>'">Order Now</button>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <div class="no-products">No products available</div>
                                <% } %>
            </div>
        </div>

        <%- include('partials/footer', { user: user }) %>

    <script src="/JS/shop.js"></script>
</body>

</html>