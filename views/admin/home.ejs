  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const tableSelector = document.getElementById("tableSelector");
      const tableData = document.getElementById("tableData");

      // Fetch and populate table names
      fetch("/admin/api/tables")
        .then(res => res.json())
        .then(tables => {
          tables.forEach(name => {
            const opt = document.createElement("option");
            opt.value = name;
            opt.textContent = name;
            tableSelector.appendChild(opt);
          });
        });

      // On table select, fetch and display data
      tableSelector.addEventListener("change", () => {
        const selected = tableSelector.value;
        fetch(`/admin/api/table/${selected}`)
          .then(res => res.json())
          .then(data => renderTable(selected, data));
      });

function renderTable(name, data) {
  if (!data.length) {
    tableData.innerHTML = "<p>No data found in this table.</p>";
    return;
  }

  const columns = Object.keys(data[0]);
  let html = `<div class="table-wrapper"><table class="data-table"><thead><tr>`;
  columns.forEach(col => html += `<th>${col}</th>`);
  html += `<th>Actions</th></tr></thead><tbody>`;

  data.forEach(row => {
    html += `<tr data-id="${row.id}">`;
    columns.forEach(col => {
      const cellValue = row[col] == null ? "" : String(row[col]);
      const isTooLong = cellValue.length > 100;
      const displayValue = isTooLong ? cellValue.slice(0, 100) + "..." : cellValue;
      html += `
        <td contenteditable="true" 
            data-column="${col}" 
            data-full="${cellValue.replace(/"/g, '&quot;')}">
          ${displayValue}
        </td>`;
    });
    html += `<td><button onclick="updateRow('${name}', ${row.id}, this)">Save</button></td></tr>`;
  });

  html += `</tbody></table></div>`;
  tableData.innerHTML = html;
}

      window.updateRow = (table, id, btn) => {
        const row = btn.closest("tr");
        const updates = {};
        row.querySelectorAll("td[data-column]").forEach(td => {
          const col = td.dataset.column;
          if (col !== 'id') updates[col] = td.textContent.trim();
        });

        fetch(`/admin/api/table/${table}/update`, {
          method: "POST",
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, updates })
        })
        .then(res => res.json())
        .then(data => {
          if (data.success) alert("Row updated successfully!");
          else alert("Failed to update row.");
        });
      };
    });
  </script>

